# Copia a .env en el VPS y rellena. Nunca subas .env al repositorio.
# Modo global de la cola de operaciones (WF-00): off | shadow | allowlist | live
MODO_OPERACION=shadow
TZ=America/Bogota

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# n8n
N8N_HOST=
N8N_ENCRYPTION_KEY=

# Cliente (se rotan al cierre del proyecto)
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
MERCATELY_API_KEY=
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Composio: acceso a la carpeta de fuentes del cliente en Drive (ADR-003). Solo lectura.
COMPOSIO_API_KEY=
COMPOSIO_DRIVE_CARPETA_ID=
